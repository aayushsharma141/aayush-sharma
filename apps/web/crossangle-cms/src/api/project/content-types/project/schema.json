{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Projects"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "client": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "residential",
        "commercial"
      ]
    },
    "category": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "budget": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "brief": {
      "type": "blocks"
    },
    "approach": {
      "type": "blocks"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "materials": {
      "type": "component",
      "component": "project.material",
      "repeatable": true
    },
    "testimonial": {
      "type": "component",
      "component": "project.testimonial",
      "repeatable": false
    },
    "gallery": {
      "type": "component",
      "component": "project.gallery-item",
      "repeatable": true
    }
  }
}
